{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__ccd_turn__update_plan",
      "mcp__ccd_turn__wrap_up",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__tabs_context",
      "mcp__ccd_session_mgmt__get_session",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_connectors__session_connectors_status",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(node --check *)",
      "Bash(curl -s -m 5 http://127.0.0.1:11434/api/tags*)",
      "Bash(wsl.exe -l -v*)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git archive *)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify update .)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(bash /c/Users/Kadir/Desktop/AI-DND-TOOLS/slot.sh *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git worktree remove *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push origin dev/ai-dnd*)",
      "Bash(git push -u origin dev/ai-dnd*)",
      "Bash(git push * HEAD:dev/ai-dnd*)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Read(//c/Users/Kadir/Desktop/apikeys.txt)",
      "Read(//**/apikeys*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/*.pem)",
      "Read(/pnpm-lock.yaml)",
      "Read(/uv.lock)"
    ]
  }
}
