{"case": "E4", "mode": "do", "input": "Sinirliyim ama ona saldırmıyorum.", "http": 200, "seconds": 1.8, "shown": "Hlin: “Tamam tamam, sakinleşin dostum! Ben sadece biraz dinlenmek istedim, sizi incitmek kastım yok. Neden sinirli oldunuz acaba? Eğer öfkeliyseniz, bu sokaklarda dolaşmayı bırakayım mı?”", "action": "dialogue", "status": "experimental_attributed_speech", "model_sent": ["qwen3.5:9b-q4_K_M"], "model_seen": ["qwen3.5:9b-q4_K_M"], "model_calls": 1, "before": {"location": "fr:city:neverwinter", "hp": 12, "combat": false, "marks": {}, "npc_hp": {"npc_001": 12}, "absence": []}, "after": {"location": "fr:city:neverwinter", "hp": 12, "combat": false, "marks": {}, "npc_hp": {"npc_001": 12}, "absence": []}, "detail": null}
