{"case": "E5", "mode": "ask_dm", "input": "Ona saldırsam ne olur?", "http": 200, "seconds": 0.1, "shown": "Bu konuda duyduğun hiçbir söz sağlam görünmüyor; doğrusunu öğrenmek için biraz daha dinlemen gerekecek.", "action": "dialogue", "status": "unverified", "model_sent": [], "model_seen": [], "model_calls": 0, "before": {"location": "fr:city:neverwinter", "hp": 12, "combat": false, "marks": {}, "npc_hp": {"npc_001": 12}, "absence": []}, "after": {"location": "fr:city:neverwinter", "hp": 12, "combat": false, "marks": {}, "npc_hp": {"npc_001": 12}, "absence": []}, "detail": null}
