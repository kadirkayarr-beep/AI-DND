{
  "schema_version": 1,
  "required_paths": [
    "ai-dnd/game.py",
    "ai-dnd/api/main.py",
    "ai-dnd/api/ollama_adapter.py",
    "ai-dnd/api/session_manager.py",
    "ai-dnd/api/lore_authority",
    "ai-dnd/api/campaign_journal.py",
    "ai-dnd/scripts/run_regression_evidence.py",
    "ai-dnd/docs/regression-evidence.md",
    "ai-dnd/docs/evidence",
    "ai-dnd/docs/development-infrastructure.md",
    "ai-dnd/api/tests/test_model_isolation.py",
    "ai-dnd/api/tests/test_development_tooling.py",
    "artifacts/ai-dnd-experience/src",
    "artifacts/ai-dnd-experience/package.json",
    "pnpm-lock.yaml",
    "uv.lock",
    ".github/workflows/ai-dnd-ci.yml"
  ],
  "regression_selectors": [
    "api.tests.test_bounded_encounter",
    "test_regression",
    "api.tests.test_campaign_time",
    "api.tests.test_combat_lifecycle",
    "api.tests.test_model_isolation",
    "test_narrative_rebalance.TestNarrativeRebalance.test_03_no_turn_exceeds_2_model_calls",
    "test_narrative_rebalance.TestNarrativeRebalance.test_04_narration_validation_failure_does_not_retry_model",
    "api.tests.test_regression_evidence",
    "api.tests.test_development_tooling"
  ],
  "frontend_package": "artifacts/ai-dnd-experience/package.json",
  "frontend_commands": [
    {"name": "frontend_libraries", "argv": ["pnpm", "run", "typecheck:libs"]},
    {"name": "frontend_typecheck", "argv": ["pnpm", "--filter", "@workspace/ai-dnd-experience", "run", "typecheck"]},
    {"name": "frontend_test", "argv": ["pnpm", "--filter", "@workspace/ai-dnd-experience", "run", "test"]},
    {"name": "frontend_build", "argv": ["pnpm", "--filter", "@workspace/ai-dnd-experience", "run", "build"]}
  ],
  "command_timeout_seconds": 300
}