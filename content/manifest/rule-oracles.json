  "open_leaves": [
    {"family": "save", "rule": "skill_proficiency_choices_and_save_total_in_play", "status": "OPEN", "reason": "class skill-choice counts/options, background skills, and the saving-throw total applied during play (saving_bonus, feat/species adders, exhaustion) are not oracle-covered; the creation save modifiers cover only the level-1 Proficiency Bonus of 2 (higher levels belong to C06); Sorcerer saves were read in C06 and are also run here"},
    {"family": "d20_test", "rule": "advantage_disadvantage_source_aggregation", "status": "OPEN", "reason": "several sources of one kind collapse to one state before roll_d20; not covered"},
    {"family": "hit_points", "rule": "heal_cap_and_temp_hp_no_stack_choice", "status": "OPEN", "reason": "PHB lets the player choose between two Temporary Hit Point amounts; the engine keeps the higher automatically"},
    {"family": "hit_points", "rule": "death_saves_and_stable", "status": "OPEN"},
    {"family": "combat_order", "rule": "initiative_surprise", "status": "OPEN"},
    {"family": "state", "rule": "conditions", "status": "OPEN"},
    {"family": "state", "rule": "long_rest_hit_dice_ability_scores_and_spacing", "status": "OPEN", "reason": "NO_ENGINE_RESOLVER: the engine has no Hit Point Dice resource (all spent Hit Dice regained), no ability-score restoration, no 16-hour spacing between Long Rests (PDF 369)"},
    {"family": "state", "rule": "short_rest", "status": "OPEN", "reason": "not covered: 1 hour minimum, spending Hit Point Dice to heal, features that recharge on a Short Rest"},
    {"family": "state", "rule": "feature_recharge_by_rest", "status": "OPEN", "reason": "species uses and spell slots are restored by Long Rest in the engine; per-feature recharge rules are not oracle-covered. ENGINE DIVERGENCE (untested): with supplies tracking on and a missing food/water record the engine skips the Exhaustion reduction, the glossary always reduces it by 1; rest interrupted by a time event and the interruptions in the glossary (rolling Initiative, casting a non-cantrip spell) are only partly covered"},
    {"family": "combat_order", "rule": "bonus_action_and_reaction_sources", "status": "OPEN", "reason": "which features grant Bonus Actions/Reactions (Cunning Action, Opportunity Attack triggers, Shield and other reaction spells, Action Surge) belong to the class/spell tasks (C05, C10-C21) and K05; free object interaction and the 'one thing at a time' rule are not oracle-covered; the dispatcher sets reaction_spent directly because the only engine reaction path needs a Ready opportunity, so 'a spent Reaction refuses a second one' and 'Incapacitated prevents a Reaction' are UNVERIFIED; the effects of Dodge, Disengage, Help, Hide, Ready, Search, Study are not covered (the leaf checks only the 12 names); not covered: Action Surge/extra actions, bonus grants of quantity > 1, out_of_turn refusals, double Dash, speed 0, prone/difficult-terrain movement cost, exhaustion/grapple speed reduction; ENGINE DIVERGENCE to settle in the conditions family: action_economy.speed() returns 0 while Incapacitated, but Incapacitated alone does not zero Speed in the 2024 rules"}
  ]
}
