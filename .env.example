# Copy to .env.local (same folder) and fill in. .env.local is never committed.
# start_local.ps1 reads it; values already set in the PowerShell window win.

# --- Sign-in (Clerk). Without these the game shows "Giriş şu anda kullanılamıyor". ---
# Browser side: the Clerk "publishable key" (pk_test_... / pk_live_...). It is public.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# API side: verifies the login token with Clerk's public keys. No secret key is needed
# (the API refuses AI_DND_CLERK_SECRET_KEY on purpose).
AI_DND_AUTH_MODE=clerk
# https:// + the domain inside the publishable key (decode its base64, drop the trailing $).
AI_DND_CLERK_ISSUER=https://REPLACE-ME.clerk.accounts.dev
# The page address(es) the game is opened from, comma separated, no trailing slash.
AI_DND_CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:22785,http://localhost:22785
# development for pk_test_ keys, production for pk_live_ keys.
AI_DND_CLERK_ENVIRONMENT=development

# --- Optional ---
# Set to 0 to turn off first-person NPC speech on "Say" turns (default is on).
# AI_DND_NPC_SPEECH=1
